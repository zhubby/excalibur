[Unit]
Description=Bytebeam DeviceAgent service
After=network.target auditd.service

[Service]
ExecStart=/usr/local/share/bytebeam/device_agent -c /usr/local/share/bytebeam/config.toml -a /mnt/download/device.json -vvv
KillMode=process
Restart=on-failure
Type=simple

[Install]
WantedBy=multi-user.target
